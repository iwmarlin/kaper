],"periods":["hollywood"]}],"films":[],"songs":[],"otherWorks":[],"titleVariants":[],"workRelations":[],"timelineEvents":[{"id":"TE0054","slug":"8-june-1937-duke-ellington-records-all-gods-chillun-got-rhythm","title":"Duke Ellington records “All God’s Chillun Got Rhythm”","label":"8 Jun 1937 · Ellington records “All God’s Chillun Got Rhythm”","displayDate":"8 June 1937","dateStart":"1937-06-08","datePrecision":"day","sortDate":"1937-06-08","sortOrder":44,"displayMode":"point","eventType":"career","period":"hollywood","periodKey":"hollywood","category":"recording","filterTags":["career","hollywood"],"placeDisplay":"New York","cityKey":"hollywood","shortDescription":"Duke Ellington and His Famous Orchestra record “All God’s Chillun Got Rhythm” in New York, carrying a Kaper–Jurmann film song into the jazz repertoire.","longDescription":"Duke Ellington and His Famous Orchestra recorded “All God’s Chillun Got Rhythm” in New York on 8 June 1937 for Master (MA 137, matrix M 519-1). Written by Bronisław Kaper and Walter Jurmann with words by Gus Kahn for A Day at the Races, the song passed from the screen into the jazz repertoire within weeks of the film’s release.","roles":["reception_publicity","work_milestone"],"personIds":["P009","P025","P077","P128"],"sourceIds":["SRC0008"],"workIds":["W-S152","W-F046"],"mediaIds":["M008","M217","M242"],"placeIds":["PL024"],"periods":["hollywood"],"heroMediaIds":["M217"]},{"id":"TE0055","slug":"5-september-1936-youre-all-i-need-among-most-played-songs","title":"“You’re All I Need” among the most-played songs of 1935–36","label":"5 Sep 1936 · “You’re All I Need” ranks 14th on the ASCAP list","displayDate":"5 September 1936","dateStart":"1936-09-05","datePrecision":"day","sortDate":"1936-09-05","sortOrder":45,"displayMode":"point","eventType":"career","period":"hollywood","periodKey":"hollywood","category":"reception","filterTags":["career","hollywood"],"placeDisplay":"United States","cityKey":"hollywood","shortDescription":"Motion Picture Herald publishes the ASCAP tabulation of songs broadcast most often in 1935–36; “You’re All I Need” ranks 14th with 21,424 performances on NBC and CBS.","longDescription":"On 5 September 1936 Motion Picture Herald printed the American Society of Composers, Authors and Publishers tabulation of the 112 songs performed at least 10,000 times over the NBC and CBS networks during 1935–36. “You’re All I Need,” written for Escapade, ranked 14th with 21,424 broadcasts — placing Kaper and Jurmann’s first American song among that year’s most-played titles, one year after their arrival. The list credits the film under its working title Lie Like Gentlemen and prints Jurmann’s name as “Walter Jarmann.”","roles":["reception_publicity","career_milestone"],"personIds":["P009","P077","P025"],"sourceIds":["SRC0569"],"workIds":["W-S119","W-F033"],"mediaIds":["M006","M241"],"periods":["hollywood"],"heroMediaIds":["M241"]}],"places":[],"contributions":[],"personNameVariants":[]}}
