72","SRC0776","SRC0782","SRC0783","SRC0784","SRC0785","SRC0788","SRC0800","SRC0803","SRC0804","SRC0806","SRC0854","SRC0855","SRC0868","SRC0869","SRC0870","SRC0871","SRC0872","SRC0873","SRC0874","SRC0875","SRC0876","SRC0877","SRC0878","SRC0882","SRC0883","SRC0887","SRC0893","SRC0927","SRC0929","SRC0962","SRC0967","SRC0973","SRC0974","SRC0976","SRC0978","SRC0979","SRC0980","SRC0983","SRC0984","SRC0985","SRC0986","SRC0987"],"authorizedNameSource":"LCNAF","authorities":[{"scheme":"lcnaf","url":"https://id.loc.gov/authorities/names/n2001062537"}]},{"id":"ORG091","displayName":"Media History Digital Library","authorizedName":"Media History Digital Library (Project)","types":["archive","database"],"city":["Madison"],"country":"United States","slug":"media-history-digital-library","nameVariants":"MHDL; Media History Digital Library; Lantern","sourceIds":["SRC0026","SRC0045","SRC0046","SRC0423","SRC0449","SRC0569","SRC0649","SRC0651","SRC0652","SRC0653","SRC0690","SRC0703","SRC0929","SRC0962","SRC0978","SRC0980","SRC0984","SRC0985"],"authorizedNameSource":"LCNAF","authorities":[{"scheme":"lcnaf","url":"https://id.loc.gov/authorities/names/no2011147658"}]}],"sources":[{"id":"SRC0978","shortCitation":"The Box Office Check-Up of 1935, p. 100 — songs in My Song for You","fullCitation":"The Box Office Check-Up of 1935. New York: Quigley Publishing Company, 1936, p. 100. Table of songs in the year’s pictures, entry for My Song for You (GB Pictures): “Ah, Yes, Thou Art Mine” (Verdi); “Ave Maria” (Franz Schubert); “Celeste Aida” (Verdi); “My Song for You” (Harms; Spoliansky; Frank Eyton); “With All My Heart” (Harms; Spoliansky; Frank Eyton). Internet Archive / Media History Digital Library.","sourceType":"press_item","title":"The Box Office Check-Up of 1935: songs in My Song for You","creator":"Quigley Publishing Company","repository":"Internet Archive / Media History Digital Library","publication":"The Box Office Check-Up of 1935","date":"1936","dateRole":"publication","dateQualifier":"confirmed","accessDate":"2026-11-08","reliability":"medium","sourceStatus":"verified","slug":"src0978-box-office-check-up-1935-my-song-for-you","organizationIds":["ORG067","ORG091"],"workIds":["W-F057"],"filmIds":["F057"],"primaryUrl":"https://archive.org/details/boxofficecheckup00quig/page/n89/mode/1up","researchNote":"The table gives, for each picture of 1935, its songs with publisher, composer and lyricist. For My Song for You it lists two songs by Mischa Spoliansky and Frank Eyton and three pieces by Verdi and Schubert, and no song by Kaper or Jurmann.","researchNoteType":"evidence_note"}],"media":[],"works":[{"id":"W-F057","title":"My Song for You","slug":"my-song-for-you","sortTitle":"My Song for You","workType":"Film","year":1934,"period":"european","certainty":"probable","publicNote":"English-language version of Ein Lied für Dich, made in Britain by Gaumont British with Jan Kiepura in the leading role. No document of the time credits Bronisław Kaper: The Box Office Check-Up of 1935 lists the film’s songs as Mischa Spoliansky and Frank Eyton’s “My Song for You” and “With All My Heart”, with pieces by Verdi and Schubert. Sieghardt’s catalogue names Spoliansky, Kaper and Jurmann for its music and says “Ninon”, from the German original, was sung in it in English; the English “Ninon” registered in 1933 is from A Song for You, the British title of Ein Lied für Dich.","publicScope":"standalone_page","sourceIds":["SRC0306","SRC0373","SRC0889","SRC0962","SRC0978"],"contributionIds":["CON-F057-D-P204","CON-F057-PC-ORG167"],"personIds":["P204"],"organizationIds":["ORG167"],"filmIds":["F057"],"relationIds":["REL0214","REL0215"],"periods":["european"]}],"films":[],"songs":[],"otherWorks":[],"titleVariants":[],"workRelations":[],"timelineEvents":[],"places":[],"contributions":[],"personNameVariants":[]}}
