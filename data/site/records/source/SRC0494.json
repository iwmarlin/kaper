","W-S197","W-S198","W-S199","W-S200","W-S201","W-S202","W-S204","W-S205","W-S206","W-S207","W-S208","W-S209","W-S210","W-S211","W-S212","W-S213","W-S214","W-S215"],"birthYear":1902,"deathYear":1983,"lifeDatesCertainty":"confirmed"},{"id":"P121","displayName":"Róża Etkin","sortName":"Etkin, Róża","slug":"roza-etkin","primaryRole":"performer","roles":["pianist","performer"],"sourceIds":["SRC0367","SRC0459","SRC0490","SRC0494","SRC0503"],"timelineEventIds":["TE0018"],"contributionIds":["CON-O005-P-P121"],"workIds":["W-O005"],"authorityUrl":"NIFC / Chopin Biography: https://chopin.nifc.pl/en/chopin/osoba/24_etkin_roza","birthYear":1908,"deathYear":1945,"lifeDatesCertainty":"confirmed"}],"organizations":[{"id":"ORG073","displayName":"American Film Institute","authorizedName":"American Film Institute","types":["archive","database"],"city":["Los Angeles"],"country":"United States","slug":"american-film-institute","nameVariants":"AFI; AFI Catalog; AFI Catalog of Feature Films; American Film Institute Louis B. Mayer Library","sourceIds":["SRC0140","SRC0141","SRC0142","SRC0143","SRC0144","SRC0145","SRC0146","SRC0147","SRC0148","SRC0167","SRC0176","SRC0402","SRC0480","SRC0481","SRC0482","SRC0494"]}],"sources":[{"id":"SRC0494","shortCitation":"Kaper oral history interview by Irene Kahn Atkins, AFI, 1975","fullCitation":"Bronisław Kaper, oral history interview by Irene Kahn Atkins, July 14–October 14, 1975, transcript, OH 31, vols. 1–2, Oral History Collection, American Film Institute Louis B. Mayer Library, Los Angeles.","sourceType":"archival_document","title":"Bronisław Kaper oral history interview","creator":"Bronisław Kaper; Irene Kahn Atkins","repository":"American Film Institute Louis B. Mayer Library, Los Angeles","publication":"Oral History Collection","date":"14 July–14 October 1975","reliability":"high","sourceStatus":"verified_with_attribution_note","slug":"src0494-bronislaw-kaper-oral-history-interview-1975","personIds":["P009","P121"],"organizationIds":["ORG073"],"workIds":["W-O005"],"timelineEventIds":["TE0018","TE0052","TE0053"],"otherWorkIds":["O005"],"contributionIds":["CON-O005-HI-ORG056","CON-O005-P-P121"],"placeIds":["PL030","PL038","PL045"]}],"media":[],"works":[{"id":"W-O005","title":"Sonatina for Piano","slug":"sonatina-for-piano","sortTitle":"Sonatina for Piano","workType":"Other","year":1927,"period":"european","certainty":"confirmed","displayOnSite":true,"publicScope":"standalone_page","sourceIds":["SRC0009","SRC0494"],"mediaIds":["M012","M013","M014"],"timelineEventIds":["TE0018"],"contributionIds":["CON-O005-C-P009","CON-O005-HI-ORG056","CON-O005-P-P121"],"personIds":["P009","P121"],"organizationIds":["ORG056"],"otherWorkIds":["O005"],"periods":["european"]}],"films":[],"songs":[],"otherWorks":[],"titleVariants":[],"workRelations":[],"timelineEvents":[{"id":"TE0018","slug":"1927-performance-of-piano-pieces","title":"Róża Etkin performs Kaper’s Sonatina in Berlin","label":"1927 · Etkin performs Sonatina","displayDate":"1927","dateStart":"1927-01-01","datePrecision":"year","sortDate":"1927-07-01","sortOrder":18,"displayMode":"point","eventType":"career","period":"european","periodKey":"european","category":"concert_life","filterTags":["career","europe"],"placeDisplay":"Berlin","cityKey":"berlin","shortDescription":"Róża Etkin performs Kaper’s Sonatina in Berlin, a performance later confirmed by Kaper’s oral-history recollection.","longDescription":"A 1927 German press notice documents the Berlin performance context, and Kaper’s later oral-history recollection identifies the work as his Sonatina.","roles":["career_milestone","work_milestone"],"personIds":["P009","P121"],"sourceIds":["SRC0367","SRC0494"],"workIds":["W-O005"],"mediaIds":["M031","M088","M090"],"heroMediaIds":["M088"],"placeIds":["PL002","PL041"],"periods":["european"]},{"id":"TE0052","slug":"ninon-mayer-ritz-meeting-mgm-contract","title":"Ninon reaches Louis B. Mayer: the Ritz meeting and MGM contract","label":"Ninon opens the MGM path","displayDate":"August 1934","dateStart":"1934-08-07","datePrecision":"circa_year","sortDate":"1934-08-07","sortOrder":33.5,"displayMode":"point","eventType":"career","period":"european","periodKey":"european","category":"migration","filterTags":["career","europe"],"placeDisplay":"Paris","cityKey":"paris","shortDescription":"The European success of Ninon reportedly brought Kaper and Jurmann to the attention of Louis B. Mayer, leading to a meeting at the Hôtel Ritz and an MGM contract.","longDescription":"Kaper later recalled that the success of Ninon—written for Tout pour l’amour, the French version of Ein Lied für Dich—was the turning point that opened the path to Hollywood. During his European talent-scouting trip in August 1934, Louis B. Mayer reportedly asked to meet the song’s authors, heard them perform at the Hôtel Ritz, and offered a seven-year MGM contract.","featured":true,"roles":["career_milestone","migration_event","professional_network"],"personIds":["P009","P077","P116","P117"],"sourceIds":["SRC0491","SRC0494"],"workIds":["W-F023","W-F025","W-S076","W-S077"],"mediaIds":["M034","M051"],"heroMediaIds":["M051"],"placeIds":["PL003","PL023","PL038"],"periods":["european"]},{"id":"TE0053","slug":"mgm-markets-kaper-jurmann-viennese-composers","title":"MGM markets Kaper and Jurmann as “Viennese composers”","label":"MGM’s “Viennese” label","displayDate":"20 November–8 December 1934","dateStart":"1934-11-20","dateEnd":"1934-12-08","datePrecision":"range","sortDate":"1934-11-20","sortOrder":35.5,"displayMode":"point","eventType":"career","period":"european","periodKey":"european","category":"reception","filterTags":["career","hollywood"],"placeDisplay":"Hollywood/Los Angeles","cityKey":"hollywood","shortDescription":"American studio publicity recast Kaper and Jurmann as a Viennese composing team, turning “Vienna” into a promotional brand rather than a biographical fact.","longDescription":"Soon after their arrival at MGM, the American press and studio publicity presented Kaper and Jurmann as “Viennese composers” and as a brilliant Viennese musical team. The label suited MGM’s first use of the duo in Escapade, a Hollywood remake of the Viennese film Maskerade, but it was biographically misleading for Kaper, whose career had developed in Warsaw and Berlin. The event marks the moment when Hollywood began to translate his European professional history into a marketable studio identity.","featured":true,"roles":["reception_publicity","career_milestone"],"personIds":["P009","P077","P116"],"sourceIds":["SRC0491","SRC0494","SRC0550"],"workIds":["W-F033"],"mediaIds":["M034","M051","M228"],"heroMediaIds":["M228"],"placeIds":["PL004","PL005","PL006","PL012","PL030"],"periods":["european"]}],"places":[{"id":"PL030","displayName":"Vienna","authorizedName":"Vienna / Wien","placeType":"city","city":"Vienna","region":"Vienna","country":"Austria","latitude":48.2082,"longitude":16.3738,"period":"european","slug":"vienna","publicNote":"Vienna functions here as a European music-film and publicity context for the Berlin–Paris–Hollywood route and the star-singer circuit. MGM’s later “Viennese composers” label is not presented as Kaper’s biographical origin.","mapPrecision":"city_level","publicScope":"context_only","timelineEventIds":["TE0028","TE0050","TE0051","TE0053"],"mediaIds":["M095"],"sourceIds":["SRC0490","SRC0491","SRC0494"],"periods":["european"]},{"id":"PL038","displayName":"London","authorizedName":"London","placeType":"city","city":"London","region":"Greater London","country":"United Kingdom","latitude":51.5074,"longitude":-0.1278,"period":"european","slug":"london","publicNote":"Brief London project context before the Mayer/MGM breakthrough: Kaper later recalled a short trip to London at Sam Spiegel’s invitation for a projected Anthony Asquith film that did not materialize.","mapPrecision":"city_level","publicScope":"map_and_detail","timelineEventIds":["TE0052"],"sourceIds":["SRC0491","SRC0494"],"periods":["european"]},{"id":"PL045","displayName":"Hotel Edison, 228 West 47th Street, New York","authorizedName":"Hotel Edison, 228 West 47th Street, New York, NY","placeType":"venue","city":"New York","region":"New York","country":"United States","latitude":40.7594,"longitude":-73.9857,"period":"european","slug":"hotel-edison-new-york","publicNote":"New York hotel where Kaper and his wife Eleonora stayed on arrival from Le Havre before travelling on to Los Angeles. In his 1975 AFI oral history Kaper recalled the Edison Hotel as the studio's $300-a-week accommodation tier.","mapPrecision":"venue_level","publicScope":"map_and_detail","timelineEventIds":["TE0035"],"mediaIds":["M275"],"sourceIds":["SRC0494","SRC0572"],"periods":["european"]}],"contributions":[],"personNameVariants":[]}}
